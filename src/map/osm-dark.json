{
  "version": 8,
  "name": "OpenStreetMap",
  "metadata": { "maputnik:renderer": "mlgljs" },
  "sources": {
    "carto": {
      "type": "vector",
      "url": "https://tiles.basemaps.cartocdn.com/vector/carto.streets/v1/tiles.json"
    }
  },
  "sprite": "https://tiles.basemaps.cartocdn.com/gl/positron-gl-style/sprite",
  "glyphs": "https://tiles.basemaps.cartocdn.com/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "layout": { "visibility": "visible" },
      "paint": {
        "background-color": "rgba(56, 73, 81, 1)",
        "background-opacity": 1
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "carto",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 24,
      "filter": ["all", ["==", "$type", "Polygon"]],
      "layout": { "visibility": "visible" },
      "paint": {
        "fill-color": "rgba(0, 0, 0, 1)",
        "fill-antialias": true,
        "fill-translate-anchor": "map",
        "fill-opacity": 1
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all", ["==", "class", "rail"]],
      "layout": { "visibility": "visible", "line-join": "round" },
      "paint": {
        "line-color": "rgba(54, 54, 54, 1)",
        "line-width": {
          "base": 1,
          "stops": [[13, 0.5], [14, 1], [15, 1], [16, 3], [21, 7]]
        }
      }
    },
    {
      "id": "road_service",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 15,
      "maxzoom": 24,
      "filter": ["all", ["==", "class", "service"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [[15, 2], [16, 2], [17, 4], [18, 6]]
        },
        "line-opacity": 1,
        "line-color": "rgba(98, 98, 98, 1)"
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 13,
      "maxzoom": 24,
      "filter": ["all", ["==", "class", "minor"]],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [
            [11, 0.5],
            [12, 0.5],
            [14, 2],
            [15, 4],
            [16, 6],
            [17, 10],
            [18, 14]
          ]
        },
        "line-opacity": 1,
        "line-color": "rgba(111, 111, 111, 1)"
      }
    },
    {
      "id": "road_secondary",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 12,
      "maxzoom": 24,
      "filter": ["all", ["in", "class", "secondary", "tertiary"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [
            [11, 2],
            [13, 2],
            [14, 3],
            [15, 4],
            [16, 6],
            [17, 10],
            [18, 14]
          ],
          "base": 2
        },
        "line-opacity": 1,
        "line-color": "rgba(164, 155, 155, 1)"
      }
    },
    {
      "id": "road_primary",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 9,
      "maxzoom": 24,
      "filter": ["all", ["==", "class", "primary"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [[12, 1], [13, 1.5], [14, 2], [15, 3], [16, 6], [17, 8]]
        },
        "line-opacity": 1,
        "line-color": "rgba(181, 162, 105, 1)"
      }
    },
    {
      "id": "road_trunk",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 7,
      "maxzoom": 24,
      "filter": ["all", ["==", "class", "trunk"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [
            [11, 1],
            [13, 2],
            [14, 4],
            [15, 6],
            [16, 8],
            [17, 12],
            [18, 16]
          ]
        },
        "line-opacity": 1,
        "line-color": "rgba(216, 195, 85, 1)"
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "carto",
      "source-layer": "transportation",
      "minzoom": 0,
      "maxzoom": 24,
      "filter": ["all", ["==", "class", "motorway"]],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-width": {
          "stops": [
            [10, 1],
            [12, 2],
            [13, 3],
            [14, 5],
            [15, 7],
            [16, 9],
            [17, 11],
            [18, 20]
          ]
        },
        "line-opacity": 1,
        "line-color": "rgba(67, 173, 55, 1)"
      }
    },

    {
      "id": "airport_runway",
      "type": "line",
      "source": "carto",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": ["all", ["==", "class", "runway"]],
      "layout": { "line-cap": "square" },
      "paint": {
        "line-width": {
          "stops": [[11, 1], [20, 40]]
        },
        "line-color": "hsl(234, 25%, 76%)"
      }
    },
    {
      "id": "airport_taxiway",
      "type": "line",
      "source": "carto",
      "source-layer": "aeroway",
      "minzoom": 13,
      "filter": ["all", ["==", "class", "taxiway"]],
      "layout": { "line-cap": "square" },
      "paint": {
        "line-width": {
          "stops": [[13, 0.5], [16, 1]]
        },
        "line-color": "hsl(234, 25%, 76%)"
      }
    },
    {
      "id": "building-top",
      "type": "fill",
      "source": "carto",
      "source-layer": "building",
      "paint": {
        "fill-translate": {
          "base": 1,
          "stops": [[14, [0, 0]], [16, [-2, -2]]]
        },
        "fill-color": "rgba(78, 78, 78, 1)",
        "fill-opacity": {
          "base": 1,
          "stops": [[13, 0], [16, 1]]
        }
      }
    },
    {
      "id": "roadname_minor",
      "type": "symbol",
      "source": "carto",
      "source-layer": "transportation_name",
      "minzoom": 16,
      "filter": ["all", ["in", "class", "minor", "service"]],
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Noto Sans Regular"],
        "text-size": 16,
        "text-field": "{name:nonlatin}",
        "symbol-avoid-edges": false,
        "symbol-spacing": 200,
        "text-pitch-alignment": "auto",
        "text-rotation-alignment": "auto",
        "text-justify": "center"
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 1)",
        "text-halo-color": "rgba(0, 0, 0, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "roadname_trunk",
      "type": "symbol",
      "source": "carto",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["all", ["in", "class", "trunk", "primary", "secondary"]],
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Noto Sans Regular"],
        "text-field": "{name}",
        "symbol-avoid-edges": false,
        "symbol-spacing": 200,
        "text-pitch-alignment": "auto",
        "text-rotation-alignment": "auto",
        "text-justify": "center",
        "text-size": 20,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 1)",
        "text-halo-color": "rgba(0, 0, 0, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "roadname_motorway",
      "type": "symbol",
      "source": "carto",
      "source-layer": "transportation_name",
      "minzoom": 9,
      "filter": ["all", ["==", "class", "motorway"]],
      "layout": {
        "symbol-placement": "line",
        "text-font": ["Noto Sans Regular"],
        "text-size": 20,
        "text-field": "{name}",
        "symbol-avoid-edges": false,
        "symbol-spacing": 200,
        "text-pitch-alignment": "auto",
        "text-rotation-alignment": "auto",
        "text-justify": "center"
      },
      "paint": {
        "text-color": "rgba(255, 255, 255, 1)",
        "text-halo-color": "rgba(0, 0, 0, 1)",
        "text-halo-width": 1
      }
    },
    {
      "id": "place_other",
      "type": "symbol",
      "metadata": {
        "mapbox:group": "1444849242106.713"
      },
      "source": "carto",
      "source-layer": "place",
      "filter": [
        "!in",
        "class",
        "city",
        "town",
        "village",
        "state",
        "country",
        "continent"
      ],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-letter-spacing": 0.1,
        "text-max-width": 9,
        "text-size": {
          "base": 1.2,
          "stops": [[12, 10], [15, 14]]
        },
        "text-transform": "uppercase",
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#FFF",
        "text-halo-color": "#000",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place_city",
      "type": "symbol",
      "metadata": {
        "mapbox:group": "1444849242106.713"
      },
      "source": "carto",
      "source-layer": "place",
      "filter": [
        "all",
        ["!=", "capital", 2],
        ["in", "class", "city", "town", "village"]
      ],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": {
          "base": 1.2,
          "stops": [[7, 14], [11, 24]]
        },
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#FFF",
        "text-halo-color": "#000",
        "text-halo-width": 1.2
      }
    }
  ],
  "id": "voyager",
  "owner": "Carto"
}
